name: " iRingo: 🌤 WeatherKit"
desc: |-
  iOS 18–27 & macOS 15+ & watchOS 11+
  1.解锁全部天气功能
  2.替换空气质量数据
  3.添加下一小时降水数据
  4.添加天气数据
  5.保留 iOS 27 新增天气产品
openUrl: "http://boxjs.com/#/app/iRingo.WeatherKit"
author: |-
  VirgilClyne[https://github.com/VirgilClyne]
  WordlessEcho[https://github.com/WordlessEcho]
  001[https://github.com/001ProMax]
homepage: "https://NSRingo.github.io/guide/Weather/weather-kit"
icon: "https://developer.apple.com/assets/elements/icons/weatherkit/weatherkit-128x128.png"
category: " iRingo"
date: "2026-08-02 17:23:14"
version: "3.2.0-ios27.7"

rules:
  - DOMAIN,weather-analytics-events.apple.com,REJECT-DROP
  - DOMAIN-SUFFIX,tthr.apple.com,REJECT-DROP
  - DOMAIN,tether.edge.apple,REJECT-DROP
  - AND,((OR,((IP-ASN,714,no-resolve),(IP-ASN,6185,no-resolve))),(PROTOCOL,QUIC)),REJECT-DROP

http:
  mitm:
    - "weatherkit.apple.com"
    - "www.qweather.com"
  script:
    - match: ^https?:\/\/weatherkit\.apple\.com\/api\/v1\/airQualityScale\/
      name: WeatherKit.api.v1.airQualityScale.request
      type: request
      require-body: false
      argument:
    - match: ^https?:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/
      name: WeatherKit.api.v2.weather.request
      type: request
      require-body: false
      argument:
    - match: ^https?:\/\/weatherkit\.apple\.com\/api\/v1\/weatherAlerts\?[^#]*&ids=[^&#]*-[0-9]{9}(?:&|$)
      name: WeatherKit.api.v1.weatherAlerts.request
      type: request
      require-body: false
      argument:
    - match: ^https?:\/\/weatherkit\.apple\.com\/api\/v1\/airQualityScale\/
      name: WeatherKit.api.v1.airQualityScale.response
      type: response
      require-body: true
      argument:
    - match: ^https?:\/\/weatherkit\.apple\.com\/api\/v1\/availability\/
      name: WeatherKit.api.v1.availability.response
      type: response
      require-body: true
      argument:
    - match: ^https?:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/
      name: WeatherKit.api.v2.weather.response
      type: response
      require-body: true
      binary-mode: true
      argument:
  url-rewrite:
    # 🌤 WeatherKit.alertDetails.index.response
    - ^https?:\/\/www\.qweather\.com\/\/?severe-weather\/([^/?#]+)\.html\?from=AppleWeatherService$ https://weatherkit.apple.com/alertDetails/index.html?ids=$1&lang=zh-CN&party=qweather 302
    - ^https?:\/\/www\.qweather\.com\/en\/severe-weather\/([^/?#]+)\.html\?from=AppleWeatherService$ https://weatherkit.apple.com/alertDetails/index.html?ids=$1&lang=en-US&party=qweather 302

script-providers:
  WeatherKit.api.v1.airQualityScale.request:
    url: https://raw.githubusercontent.com/LamontLiao/WeatherKit/WeatherkitFix27/modules/WeatherkitFix27/request.bundle.js
    interval: 86400
  WeatherKit.api.v2.weather.request:
    url: https://raw.githubusercontent.com/LamontLiao/WeatherKit/WeatherkitFix27/modules/WeatherkitFix27/request.bundle.js
    interval: 86400
  WeatherKit.api.v1.weatherAlerts.request:
    url: https://raw.githubusercontent.com/LamontLiao/WeatherKit/WeatherkitFix27/modules/WeatherkitFix27/request.bundle.js
    interval: 86400
  WeatherKit.api.v1.airQualityScale.response:
    url: https://raw.githubusercontent.com/LamontLiao/WeatherKit/WeatherkitFix27/modules/WeatherkitFix27/response.bundle.js
    interval: 86400
  WeatherKit.api.v1.availability.response:
    url: https://raw.githubusercontent.com/LamontLiao/WeatherKit/WeatherkitFix27/modules/WeatherkitFix27/response.bundle.js
    interval: 86400
  WeatherKit.api.v2.weather.response:
    url: https://raw.githubusercontent.com/LamontLiao/WeatherKit/WeatherkitFix27/modules/WeatherkitFix27/response.bundle.js
    interval: 86400
